APP_NAME=Ningredy
ADMIN_NAME=ningredy
ADMIN_EMAIL=ningredy@local.test
ADMIN_PASSWORD=change-me
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
PUBLIC_STORAGE_URL=/storage
APP_TIMEZONE=Europe/Kyiv

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=sqlite
DB_BUSY_TIMEOUT=60000
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_QUEUE_RETRY_AFTER=2220
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram Bot API
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PROXY_URL=
# Comma-separated Telegram user IDs. Empty blocks every user.
TELEGRAM_ALLOWED_USER_IDS=

# AI product research
OPENAI_API_KEY=
OPENAI_STORE=false
AI_PRODUCT_RESEARCH_MODEL=gpt-5.4
AI_PRODUCT_IMAGE_VISION_MODEL=gpt-5.4-mini
AI_PRODUCT_IMAGE_VISION_TIMEOUT=45
AI_PRODUCT_IMAGE_DISCOVERY_MODEL=gpt-5.4
AI_PRODUCT_IMAGE_DISCOVERY_TIMEOUT=75
# Generative photo touch-up (admin-triggered only, never automatic)
AI_IMAGE_UPSCALE_MODEL=gpt-image-2
AI_IMAGE_UPSCALE_TIMEOUT=90
# Gallery ordering strategy: heuristic (code rules, hero first) or model (the vision model assigns gallery_rank)
PRODUCT_IMAGE_RANKING=heuristic

# Optional - $ per million tokens, used to show an estimated cost alongside token
# counts in Telegram and the AI settings page. Leave blank to show tokens only.
AI_PRICE_OPENAI_GPT_5_4_INPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_CACHED_INPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_OUTPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_REASONING_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_MINI_INPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_MINI_CACHED_INPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_MINI_OUTPUT_PER_1M=
AI_PRICE_OPENAI_GPT_5_4_MINI_REASONING_PER_1M=
AI_PRICE_OPENAI_GPT_4O_TRANSCRIBE_INPUT_PER_1M=
AI_PRICE_OPENAI_GPT_4O_TRANSCRIBE_OUTPUT_PER_1M=
AI_PRICE_DEEPSEEK_V4_FLASH_INPUT_PER_1M=
AI_PRICE_DEEPSEEK_V4_FLASH_CACHED_INPUT_PER_1M=
AI_PRICE_DEEPSEEK_V4_FLASH_OUTPUT_PER_1M=
AI_SERVER_ASSISTANT_MODEL=gpt-5.4
AI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
TELEGRAM_VOICE_MAX_SECONDS=300
TELEGRAM_VOICE_MAX_BYTES=20971520
